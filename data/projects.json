let ALL_PROJECTS = [], curList = [], curFilter = 'all', curIdx = 0;

async function loadPortfolio(){
  try{ const r = await fetch(RAW_URL,{cache:'no-store'}); if(r.ok){ const d = await r.json(); if(d && Array.isArray(d.projects)) return d.projects; } }catch(e){}
  try{ const r = await fetch('data/projects.json',{cache:'no-store'}); if(r.ok){ const d = await r.json(); if(d && Array.isArray(d.projects)) return d.projects; } }catch(e){}
  return DEFAULT_PROJECTS;
}

function toEmbed(url){
  if(!url) return '';
  url = String(url).trim();
  if(/youtube\.com\/embed\//i.test(url) || /video_ext\.php/i.test(url)) return url;
  let m = url.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|shorts\/|live\/|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{6,})/i);
  if(m) return 'https://www.youtube.com/embed/'+m[1]+'?rel=0';
  m = url.match(/(?:vk\.com|vkvideo\.ru)\/(?:video|clip)(-?\d+)_(\d+)/i);
  if(m) return 'https://vk.com/video_ext.php?oid='+m[1]+'&id='+m[2]+'&hd=2';
  m = url.match(/[?&]z=(?:video|clip)(-?\d+)_(\d+)/i);
  if(m) return 'https://vk.com/video_ext.php?oid='+m[1]+'&id='+m[2]+'&hd=2';
  return '';
}

/* ---------- ФИЛЬТР КАТЕГОРИЙ ---------- */
function renderCatBar(){
  const bar = $('#catBar');
  const keys = ['all', ...Object.keys(CATEGORIES)];
  bar.innerHTML = keys.map(k=>`<button class="cat-btn ${k===curFilter?'on':''}" data-cat="${k}">${k==='all'?'ВСЕ':CATEGORIES[k]}</button>`).join('');
}
$('#catBar').addEventListener('click', e=>{
  const b = e.target.closest('.cat-btn'); if(!b) return;
  curFilter = b.dataset.cat;
  renderCatBar(); renderWorks();
});

/* ---------- РЕНДЕР КАРТОЧЕК (асимметричный паттерн сохраняется) ---------- */
const PATTERN = ['w-full','w-tall','w-side','w-editorial','w-wide','w-offset'];
function renderWorks(){
  curList = curFilter==='all' ? ALL_PROJECTS.slice() : ALL_PROJECTS.filter(p=>p.category===curFilter);
  const n = curList.length;
  $('#worksCount').textContent = String(n).padStart(2,'0') + ' ПРОЕКТОВ';
  const grid = $('#worksGrid');
  if(!n){ grid.innerHTML = '<div class="w-empty mono">[ В ЭТОЙ КАТЕГОРИИ ПОКА ПУСТО ]</div>'; return; }
  grid.innerHTML = curList.map((p,i)=>{
    const idx = String(i+1).padStart(2,'0');
    const cls = PATTERN[i % PATTERN.length];
    const cat = CATEGORIES[p.category] || 'ДРУГОЕ';
    const year = (p.added||'').slice(0,4) || '';
    const watch = toEmbed(p.video) ? '<span class="w-has">▶ WATCH</span>' : '';
    const cover = p.cover || IMG.backstage;
    if(cls==='w-editorial') return `
    <article class="work w-editorial" data-i="${i}">
      <div class="we-left">
        <div class="work-top mono"><span>${idx} / ${esc(cat)}</span><span>${esc(year)}</span>${watch}</div>
        <h3 class="we-title outl">${esc(p.title)}</h3>
        <div class="mono">${esc(p.client||'ПРОПЕЛЛЕР')} • ${esc(p.format||cat)}</div>
        <button class="btn work-open" data-cursor="OPEN PROJECT →">${toEmbed(p.video)?'СМОТРЕТЬ ▶':'ОТКРЫТЬ →'}</button>
      </div>
      <div class="work-media" data-cursor="OPEN PROJECT →">
        <img src="${esc(cover)}" alt="${esc(p.title)}" loading="lazy">
        <div class="work-veil"></div><div class="work-play mono">▶ PLAY</div>
      </div>
    </article>`;
    return `
    <article class="work ${cls}" data-i="${i}">
      <div class="work-media" data-cursor="OPEN PROJECT →">
        <img src="${esc(cover)}" alt="${esc(p.title)}" loading="lazy">
        <div class="work-veil"></div><div class="work-play mono">▶ PLAY</div>
        <div class="work-top mono"><span>${idx} / ${esc(cat)}</span><span>${esc(year)}</span>${watch}</div>
        <div class="work-bottom"><h3>${esc(p.title)}</h3><span class="mono">${esc(p.client||'ПРОПЕЛЛЕР')} • ${esc(p.format||cat)}</span></div>
      </div>
    </article>`;
  }).join('');
  initWorkAnims();
}
function initWorkAnims(){
  if(!(hasST && !RM)) return;
  gsap.utils.toArray('.work').forEach(w=>{
    const m = w.querySelector('.work-media');
    if(!m || m.dataset.anim) return; m.dataset.anim = 1;
    gsap.fromTo(m,{clipPath:'inset(10% 5% 10% 5%)'},{clipPath:'inset(0% 0% 0% 0%)',duration:1.1,ease:'power4.out',
      scrollTrigger:{trigger:w,start:'top 84%',once:true}});
  });
  ScrollTrigger.refresh();
}

/* ---------- СТРАНИЦА ПРОЕКТА (модалка) ---------- */
const modal = $('#caseModal'), caseBody = $('#caseBody');
function lockScroll(on){ document.documentElement.style.overflow = on ? 'hidden' : ''; }
function openCase(i){
  curIdx = i;
  const p = curList[i]; if(!p) return;
  const embed = toEmbed(p.video);
  const cat = CATEGORIES[p.category] || 'ДРУГОЕ';
  const year = (p.added||'').slice(0,4) || '—';
  const media = embed
    ? `<div class="case-frame"><iframe src="${embed}" title="${esc(p.title)}" loading="lazy" allow="autoplay; fullscreen; encrypted-media; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div>`
    : `<img src="${esc(p.cover||IMG.backstage)}" alt="${esc(p.title)}">`;
  const photos = (p.images||[]).filter(Boolean);
  const links = (p.links||[]).filter(Boolean);
  const txt = (p.task||p.idea||p.process) ? `
    <div class="case-txt">
      ${p.task?`<div><h5>ЗАДАЧА</h5><p>${esc(p.task)}</p></div>`:''}
      ${p.idea?`<div><h5>ИДЕЯ</h5><p>${esc(p.idea)}</p></div>`:''}
      ${p.process?`<div><h5>ПРОЦЕСС</h5><p>${esc(p.process)}</p></div>`:''}
    </div>` : '';
  caseBody.innerHTML = `
    <div class="case-head">
      <span class="mono"><b>${String(i+1).padStart(2,'0')} / ${esc(cat)}</b> • ${esc(year)}${embed?' • <span class="acc">▶ WATCH</span>':''}</span>
      <button class="case-close" id="caseClose">ЗАКРЫТЬ ×</button>
    </div>
    <h3 class="case-title">${esc(p.title)}</h3>
    <div class="case-media">${media}</div>
    <div class="case-meta">
      <div><h5>КАТЕГОРИЯ</h5><p>${esc(cat)}</p></div>
      <div><h5>КЛИЕНТ</h5><p>${esc(p.client||'ПРОПЕЛЛЕР')}</p></div>
      <div><h5>ФОРМАТ</h5><p>${esc(p.format||cat)}</p></div>
      <div><h5>ГОРОД</h5><p>МОСКВА — ОРЁЛ</p></div>
    </div>
    ${txt}
    ${photos.length?`<h5 class="case-h">ФОТО / ${photos.length} — НАЖМИ, ЧТОБЫ УВЕЛИЧИТЬ</h5>
    <div class="case-photos">${photos.map(u=>`<img src="${esc(u)}" alt="Фото — ${esc(p.title)}" loading="lazy">`).join('')}</div>`:''}
    ${links.length?`<h5 class="case-h">МАТЕРИАЛЫ</h5>
    <div class="case-links">${links.map(u=>`<a href="${esc(u)}" target="_blank" rel="noopener">${esc(u)}<span aria-hidden="true">↗</span></a>`).join('')}</div>`:''}
    <div class="case-nav">
      <button class="btn" id="casePrev">← ПРЕД.</button>
      <a class="btn btn-acc" href="#contact" data-navlink id="caseCta">ХОЧУ ТАКОЙ ЖЕ <span class="arr">→</span></a>
      <button class="btn" id="caseNext">СЛЕД. →</button>
      <button class="case-close" id="caseClose2" style="flex:1 1 100%">ЗАКРЫТЬ ×</button>
    </div>`;
  modal.classList.add('open'); modal.scrollTop = 0;
  lockScroll(true); lenis && lenis.stop();
  $('#caseClose').onclick = closeCase;
  $('#caseClose2').onclick = closeCase;
  $('#casePrev').onclick = ()=>openCase((i-1+curList.length)%curList.length);
  $('#caseNext').onclick = ()=>openCase((i+1)%curList.length);
  $('#caseCta').onclick = closeCase;
}
function closeCase(){
  modal.classList.remove('open');
  lockScroll(false); lenis && lenis.start();
  setTimeout(()=>{ if(!modal.classList.contains('open')) caseBody.innerHTML=''; }, 450);
}
modal.addEventListener('click', e=>{ if(e.target===modal) closeCase(); });
$('#worksGrid').addEventListener('click', e=>{
  const w = e.target.closest('.work'); if(w) openCase(+w.dataset.i);
});
