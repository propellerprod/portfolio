/* ---------- LOADER ---------- */
let _minT=false,_ready=false;
function hideLoader(){
  const l=$('#loader'); if(!l||l.dataset.done) return; l.dataset.done=1;
  document.body.classList.remove('loading');
  if(window.gsap && !RM){
    const tl=gsap.timeline({onComplete:heroIntro});
    tl.to('#loaderBar i',{scaleX:1,duration:.45,ease:'power2.inOut'},0)
      .fromTo('#loader .l-word',{yPercent:60,autoAlpha:0},{yPercent:0,autoAlpha:1,duration:.35},0)
      .to('#loader',{clipPath:'inset(0 0 100% 0)',duration:.55,ease:'power4.inOut',delay:.15})
      .set('#loader',{display:'none'});
    const c={v:0}; gsap.to(c,{v:100,duration:.6,ease:'none',onUpdate:()=>{$('#loaderCount').textContent=String(Math.round(c.v)).padStart(3,'0');}});
  } else { l.style.display='none'; heroIntro(); }
}
function tryHide(){ if(_minT&&_ready) hideLoader(); }
setTimeout(()=>{_minT=true;tryHide();}, RM?0:600);
addEventListener('load',()=>{_ready=true;tryHide();});
setTimeout(hideLoader,1600);
if(document.readyState==='complete') _ready=true;

/* ---------- LENIS ---------- */
let lenis=null;
const hasGSAP=!!window.gsap;
const hasST=!!(window.gsap&&window.ScrollTrigger);
if(hasST){ gsap.registerPlugin(ScrollTrigger); ScrollTrigger.config({ignoreMobileChanges:true}); }
if(window.Lenis && DESKTOP){
  try{
    lenis=new Lenis({lerp:.14,wheelMultiplier:1,smoothWheel:true,syncTouch:false});
    document.documentElement.classList.add('lenis','lenis-smooth');
    (function lenisLoop(time){ lenis.raf(time); requestAnimationFrame(lenisLoop); })(performance.now());
    if(hasST) lenis.on('scroll', ScrollTrigger.update);
  }catch(e){ lenis=null; }
}
function goTo(hash){
  const el=document.querySelector(hash); if(!el) return;
  if(lenis) lenis.scrollTo(el,{offset:-64,duration:1});
  else el.scrollIntoView({behavior:RM?'auto':'smooth'});
}
document.addEventListener('click', e=>{
  const a=e.target.closest('[data-navlink]'); if(!a) return;
  const hash=a.getAttribute('href');
  if(hash&&hash.startsWith('#')){ e.preventDefault(); closeMenu(); goTo(hash); }
});

function heroIntro(){
  document.body.classList.add('loaded');
  if(!hasGSAP||RM) return;
  gsap.from('.hero-title .ch',{yPercent:120,duration:1,ease:'power4.out',stagger:.05});
  gsap.from('.hero-phrase',{clipPath:'inset(0 0 100% 0)',duration:.9,ease:'power3.out',delay:.45});
  gsap.from('.hero-meta, .hero-cta',{y:24,autoAlpha:0,duration:.8,stagger:.12,delay:.7,ease:'power3.out'});
}
if(hasST && !RM){
  gsap.utils.toArray('[data-reveal]').forEach(el=>{
    gsap.fromTo(el,{y:44,autoAlpha:0},{y:0,autoAlpha:1,duration:.9,ease:'power3.out',
      scrollTrigger:{trigger:el,start:'top 88%',once:true}});
  });
  gsap.utils.toArray('[data-clip]').forEach(el=>{
    gsap.fromTo(el,{clipPath:'inset(0 0 100% 0)',y:26},{clipPath:'inset(0 0 -10% 0)',y:0,duration:1,ease:'power4.out',
      scrollTrigger:{trigger:el,start:'top 86%',once:true}});
  });
  if(DESKTOP){
    gsap.utils.toArray('[data-parallax]').forEach(img=>{
      gsap.fromTo(img,{yPercent:-6},{yPercent:6,ease:'none',
        scrollTrigger:{trigger:img.parentElement,start:'top bottom',end:'bottom top',scrub:1}});
    });
  }
}
if(hasST) addEventListener('load', ()=>ScrollTrigger.refresh());

const nav=$('#nav'), prog=$('#progress'), fixedCta=$('#fixedCta');
let contactVisible=false, sTick=false;
new IntersectionObserver(en=>{contactVisible=en[0].isIntersecting;},{threshold:.1}).observe($('#contact'));
addEventListener('scroll',()=>{
  if(sTick) return; sTick=true;
  requestAnimationFrame(()=>{
    const y=scrollY;
    nav.classList.toggle('scrolled',y>40);
    const h=document.documentElement.scrollHeight-innerHeight;
    prog.style.transform='scaleX('+(h>0?y/h:0)+')';
    fixedCta.classList.toggle('show', y>innerHeight*.8 && !contactVisible);
    sTick=false;
  });
},{passive:true});

const burger=$('#burger');
function closeMenu(){ document.body.classList.remove('menu-open'); lenis&&lenis.start(); }
burger.addEventListener('click',()=>{
  const open=document.body.classList.toggle('menu-open');
  open?(lenis&&lenis.stop()):(lenis&&lenis.start());
});

let lastTC=0; const t0=performance.now();
(function tick(t){
  requestAnimationFrame(tick);
  if(t-lastTC<42) return; lastTC=t;
  const el=(performance.now()-t0)/1000;
  const f=Math.floor(el*24)%24,s=Math.floor(el)%60,m=Math.floor(el/60)%60,h=Math.floor(el/3600)%24;
  const p=n=>String(n).padStart(2,'0');
  const tc=$('#tc'); if(tc) tc.textContent=p(h)+':'+p(m)+':'+p(s)+':'+p(f);
  const fr=$('#frame'); if(fr) fr.textContent=String(Math.floor(el*24)).padStart(6,'0');
})();
function msk(){ const el=$('#mskTime'); if(el) el.textContent='MSK '+new Date().toLocaleTimeString('ru-RU',{timeZone:'Europe/Moscow',hour:'2-digit',minute:'2-digit'}); }
msk(); setInterval(msk,10000);

(function grain(){
  if(!DESKTOP) return;
  const cv=$('#grain'),ctx=cv.getContext('2d');
  const size=()=>{cv.width=Math.max(2,innerWidth*.5);cv.height=Math.max(2,innerHeight*.5);};
  size(); addEventListener('resize',size);
  const tiles=[];
  for(let n=0;n<4;n++){
    const t=document.createElement('canvas'); t.width=t.height=160;
    const tc2=t.getContext('2d');
    const d=tc2.createImageData(160,160);
    for(let i=0;i<d.data.length;i+=4){const v=Math.random()*255|0;d.data[i]=d.data[i+1]=d.data[i+2]=v;d.data[i+3]=24;}
    tc2.putImageData(d,0,0); tiles.push(t);
  }
  let last=0;
  (function loop(t){
    requestAnimationFrame(loop);
    if(document.hidden||t-last<130) return; last=t;
    ctx.clearRect(0,0,cv.width,cv.height);
    ctx.fillStyle=ctx.createPattern(tiles[Math.random()*4|0],'repeat');
    ctx.save(); ctx.translate(-Math.random()*160,-Math.random()*160);
    ctx.fillRect(0,0,cv.width+160,cv.height+160); ctx.restore();
  })(0);
})();

(function cursor(){
  if(!DESKTOP) return;
  document.documentElement.classList.add('has-cursor');
  const c=$('#cursor'),dot=c.querySelector('.c-dot'),lab=c.querySelector('.c-label');
  let x=innerWidth/2,y=innerHeight/2,tx=x,ty=y;
  addEventListener('mousemove',e=>{tx=e.clientX;ty=e.clientY;},{passive:true});
  (function loop(){
    requestAnimationFrame(loop);
    if(document.hidden) return;
    x+=(tx-x)*.2; y+=(ty-y)*.2;
    dot.style.transform='translate3d('+x+'px,'+y+'px,0) translate(-50%,-50%)';
    lab.style.transform='translate3d('+Math.min(x+24,innerWidth-120)+'px,'+Math.min(y+24,innerHeight-40)+'px,0)';
  })();
  document.addEventListener('mouseover',e=>{
    const t=e.target.closest('[data-cursor]');
    if(t){lab.textContent=t.dataset.cursor;c.classList.add('on');}else c.classList.remove('on');
    c.classList.toggle('link',!!e.target.closest('a,button')&&!t);
  });
})();
document.addEventListener('mouseover',e=>{
  const w=e.target.closest('.work');
  if(w&&!w.contains(e.relatedTarget)) w.classList.add('playing');
});
document.addEventListener('mouseout',e=>{
  const w=e.target.closest('.work');
  if(w&&!w.contains(e.relatedTarget)) w.classList.remove('playing');
});
(function svcPrev(){
  if(!DESKTOP) return;
  const prev=$('#svcPrev');
  let x=0,y=0,tx=0,ty=0;
  addEventListener('mousemove',e=>{
    tx=Math.min(e.clientX+30,innerWidth-320);
    ty=Math.min(Math.max(e.clientY-100,10),innerHeight-220);
  },{passive:true});
  (function loop(){
    requestAnimationFrame(loop);
    if(document.hidden) return;
    x+=(tx-x)*.12; y+=(ty-y)*.12;
    prev.style.transform='translate3d('+x+'px,'+y+'px,0) '+(prev.classList.contains('show')?'scale(1) rotate(-2deg)':'scale(.8) rotate(-4deg)');
  })();
  document.querySelectorAll('.svc').forEach(li=>{
    li.addEventListener('mouseenter',()=>{prev.src=li.dataset.img;prev.classList.add('show');});
    li.addEventListener('mouseleave',()=>prev.classList.remove('show'));
    li.addEventListener('click',()=>goTo('#contact'));
  });
})();
</script>
</body>
</html>
